ENVIRONMENT=development
# In production, use a real Postgres/MySQL URL — sqlite is fine for local dev only,
# and will NOT survive redeploys on most hosting platforms (ephemeral filesystem).
DATABASE_URL=mysql+pymysql://devsecops_user:devsecops_pass@localhost:3306/devsecops

# Shared secret the GitHub Actions workflow must send as "Authorization: Bearer <token>"
# when POSTing scan results to /api/ingest/scan.
INGEST_API_TOKEN=changeme-dev-token

# Comma-separated origins allowed to call this API with credentials (your deployed frontend URL).
CORS_ORIGINS=http://localhost:4028

# Must be identical to JWT_SECRET in the frontend's .env — used to sign/verify session tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE_MINUTES=10080

# GitHub App credentials (create/manage at https://github.com/settings/apps).
# Homepage URL: http://localhost:4028
# Authorization callback URL: http://localhost:4028/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App identity used to mint installation access tokens (bot/automation flow).
GITHUB_APP_ID=4413689
# Path to the App's downloaded private key .pem file. Alternatively set GITHUB_APP_PRIVATE_KEY
# to the PEM content directly (e.g. for hosts without a writable filesystem).
GITHUB_APP_PRIVATE_KEY_PATH=./github_app_private_key.pem
GITHUB_APP_PRIVATE_KEY=

# GitHub App webhook (forwarded locally via smee.io during development: https://smee.io/new).
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_PROXY_URL=
