# REPLACE THE VALUES BELOW WITH YOUR ACTUAL KEYS

NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummykey.updateyourkkey.here
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
NEXT_PUBLIC_GA_MEASUREMENT_ID=your-google-analytics-id-here
NEXT_PUBLIC_ADSENSE_ID=your-adsense-id-here
PERPLEXITY_API_KEY=your-perplexity-api-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here

NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# Auth — the FastAPI backend that owns the users table.
# Server-only URL used by Next.js API routes to reach the backend (never exposed to the browser).
BACKEND_URL=http://localhost:8010
# Must be identical to JWT_SECRET in backend/.env — used to sign/verify session tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-value

# GitHub OAuth App Client ID (same app as backend/.env; secret stays backend-only).
GITHUB_CLIENT_ID=
